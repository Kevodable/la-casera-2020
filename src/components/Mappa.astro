---
import { mapsEmbedUrl, mapsDirUrl } from '../lib/site';

interface Props {
  query: string;
  titolo?: string;
}

const { query, titolo = 'Mappa' } = Astro.props;
const embed = mapsEmbedUrl(query);
const direzioni = mapsDirUrl(query, 'driving');
---

<div class="mappa card" data-mappa data-src={embed}>
  <div class="mappa__placeholder" data-mappa-placeholder>
    <p class="small">La mappa è un contenuto esterno di Google: resta bloccata finché non la accetti.</p>
    <button type="button" class="btn btn--ghost btn--sm" data-mappa-attiva>Attiva la mappa</button>
  </div>
  <iframe data-mappa-iframe title={titolo} loading="lazy" hidden></iframe>
</div>
<a class="link-arrow" href={direzioni} target="_blank" rel="noopener">
  Apri in Google Maps →
</a>

<style>
  .mappa {
    position: relative;
    aspect-ratio: 4 / 3;
    padding: 0;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }

  .mappa iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .mappa__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    padding: 1.5rem;
  }

  .mappa__placeholder[hidden] {
    display: none;
  }
</style>

<script>
  const CHIAVE = 'lacasera:consenso-cookie';
  const VERSIONE = 1;

  document.querySelectorAll<HTMLElement>('[data-mappa]').forEach((el) => {
    const iframe = el.querySelector<HTMLIFrameElement>('[data-mappa-iframe]');
    const placeholder = el.querySelector<HTMLElement>('[data-mappa-placeholder]');
    const src = el.dataset.src;

    const attiva = () => {
      if (iframe && src && !iframe.getAttribute('src')) iframe.setAttribute('src', src);
      if (iframe) iframe.hidden = false;
      if (placeholder) placeholder.hidden = true;
    };

    if (document.documentElement.dataset.consensoEsterni === 'true') attiva();

    el.querySelector('[data-mappa-attiva]')?.addEventListener('click', () => {
      // Cliccare "Attiva la mappa" equivale ad accettare la categoria
      // "contenuti esterni": stessa chiave/versione usate dal cookie banner.
      let statistiche = false;
      try {
        const raw = localStorage.getItem(CHIAVE);
        if (raw) statistiche = (JSON.parse(raw).statistiche as boolean) ?? false;
      } catch {
        /* navigazione privata */
      }
      const consenso = { statistiche, esterni: true, v: VERSIONE, ts: new Date().toISOString() };
      try {
        localStorage.setItem(CHIAVE, JSON.stringify(consenso));
      } catch {
        /* navigazione privata: vale solo per questa sessione */
      }
      document.documentElement.dataset.consensoEsterni = 'true';
      window.dispatchEvent(new CustomEvent('consenso-cookie', { detail: consenso }));
      attiva();
    });

    window.addEventListener('consenso-cookie', ((e: CustomEvent) => {
      if (e.detail?.esterni) attiva();
    }) as EventListener);
  });
</script>
