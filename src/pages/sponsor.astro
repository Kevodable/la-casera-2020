---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import pagina from '../data/sponsor-page.json';
import { site, getSponsor, compilati, mailtoUrl } from '../lib/site';

const numeri = compilati(pagina.numeri.voci);
const sponsor = await getSponsor();
---

<Base title="Diventa sponsor" description={pagina.sottotitolo}>
  <section class="section">
    <div class="wrap wrap-text reveal">
      <p class="eyebrow">Sponsor</p>
      <h1 class="h-xl">{pagina.titolo}</h1>
      <p class="lead">{pagina.sottotitolo}</p>
    </div>
  </section>

  {
    numeri.length > 0 && (
      <section class="section section--surface">
        <div class="wrap">
          <p class="eyebrow">{pagina.numeri.titolo}</p>
          <p class="lead" style="margin-bottom:2rem">{pagina.numeri.testo}</p>
          <div class="grid grid--auto-sm reveal">
            {numeri.map((n) => (
              <div class="card">
                <p class="h-xl" style="color:var(--primary)">{n.valore}</p>
                <p class="small">{n.etichetta}</p>
                {n.nota && <p class="small">{n.nota}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    sponsor.length > 0 && (
      <section class="section">
        <div class="wrap">
          <p class="eyebrow">Chi ci sostiene già</p>
          <div class="grid grid--auto-sm reveal">
            {sponsor.map((s) => (
              <div class="card" style="display:flex;align-items:center;justify-content:center;aspect-ratio:3/2">
                <Image src={s.data.logo} alt={s.data.nome} width={160} style="max-width:100%;height:auto" />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--surface">
    <div class="wrap">
      <p class="eyebrow">{pagina.pacchetti.titolo}</p>
      <p class="lead" style="margin-bottom:2rem">{pagina.pacchetti.testo}</p>
      <div class="grid grid--auto reveal">
        {
          pagina.pacchetti.voci.map((p) => (
            <div class:list={['card', 'pacchetto', { 'pacchetto--evidenza': p.inEvidenza }]}>
              {p.inEvidenza && <p class="badge badge--accent">Più scelto</p>}
              <p class="h-md" style="margin-top:0.5rem">{p.nome}</p>
              {p.prezzo && <p class="h-sm" style="color:var(--primary)">{p.prezzo}</p>}
              <p class="small" style="margin-bottom:1rem">{p.descrizione}</p>
              <ul class="pacchetto__include">
                {p.include.map((voce) => (
                  <li><span>✓</span><span>{voce}</span></li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap reveal">
      <p class="eyebrow">{pagina.form.titolo}</p>
      <p class="lead" style="color:var(--muted);margin-bottom:1.5rem;max-width:var(--maxw-narrow)">{pagina.form.testo}</p>
      {site.contatti.email ? (
        <a class="btn btn--accent" href={mailtoUrl(site.contatti.email, 'Richiesta listino sponsor', 'Nome azienda:\nReferente:\n')}>
          Richiedi il listino
        </a>
      ) : (
        <p class="small">Scrivici su Instagram: <a class="link-arrow" href={`https://instagram.com/${site.contatti.instagram}`} target="_blank" rel="noopener">@{site.contatti.instagram}</a></p>
      )}
    </div>
  </section>
</Base>

<style>
  .pacchetto {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .pacchetto--evidenza {
    border-color: var(--primary);
    box-shadow: var(--shadow);
  }

  .pacchetto__include {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    margin-top: auto;
  }

  .pacchetto__include li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .pacchetto__include li span:first-child {
    color: var(--primary);
    font-weight: 700;
  }
</style>
